# ============================================================
# Ladder API 环境变量模板
# 复制为 .env 后按环境修改。所有字段带默认值，未配置时 Nest 会 fallback。
# ============================================================

# ---------- 数据库 ----------
# 开发默认：SQLite（零基础设施）
# 生产 / 本地 PGlite：postgresql://postgres:postgres@127.0.0.1:5432/ladder
DATABASE_URL="file:./dev.db"

# ---------- 鉴权 ----------
JWT_SECRET="dev-only-secret-change-me"
PORT=3000

# ---------- 对象存储（P2-1）----------
# 默认 local：文件落盘到 {cwd}/uploads/，静态资源 /uploads/* 直读
# 生产切 s3：填全 S3_* 字段后 STORAGE_BACKEND=s3
STORAGE_BACKEND=local

# -- local 模式可选覆盖 --
# STORAGE_LOCAL_ROOT="./uploads"         # 文件落盘根目录（默认 {cwd}/uploads）
# UPLOAD_URL_PREFIX="/uploads"           # 公开 URL 前缀（默认 /uploads）

# -- s3 模式必填（腾讯云 COS / 阿里云 OSS / MinIO / 七牛云 通用）--
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com    # 服务 endpoint
# S3_REGION=ap-guangzhou                                 # 区域（MinIO 可填 auto）
# S3_ACCESS_KEY=xxxxx
# S3_SECRET_KEY=xxxxx
# S3_BUCKET=ladder-audio
# S3_FORCE_PATH_STYLE=true                               # MinIO / 自建必须 true；云厂商通常 false
# -- s3 可选 --
# S3_PUBLIC_URL=https://cdn.example.com                  # CDN 前缀（不填则拼 endpoint/bucket）
# S3_KEY_PREFIX=uploads/                                  # bucket 内目录前缀（默认 uploads/）
# STORAGE_PRIVATE=true                                    # 私有桶：读取时下发限时预签名 URL（不依赖公共读/CDN）
# S3_SIGNED_URL_TTL=3600                                  # 预签名有效期（秒），默认 1 小时

# -- 本地 S3 联调（不需要云厂商账号；见 tools/s3mock/server.js）--
# 启动 mock：node tools/s3mock/server.js  →  端点 http://127.0.0.1:9002（path-style，凭证任意）
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://127.0.0.1:9002
# S3_REGION=us-east-1
# S3_ACCESS_KEY=S3RVER
# S3_SECRET_KEY=S3RVER
# S3_BUCKET=ladder-audio
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=http://127.0.0.1:9002/ladder-audio

# ---------- Web Push VAPID（P1 提醒推送）----------
# 用 `npx web-push generate-vapid-keys` 生成，勿轮换否则旧订阅失效
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:dev@ladder.local"
